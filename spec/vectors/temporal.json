      "id": "gregorian@UTC:epoch",
      "input": {
        "calendar": "gregorian",
        "zone": "UTC",
        "instant": {
          "chronology": "earth.unix.ms",
          "tick": "0"
        }
      },
      "expect": {
        "fields": {
          "year": 1970,
          "month": 1,
          "day": 1,
          "hour": 0,
          "minute": 0,
          "second": 0,
          "dayOfWeek": 4,
          "dayOfYear": 1,
          "quarter": 1
        }
      }
