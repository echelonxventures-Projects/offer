    {
      "id": "window:inside-saturday",
      "input": {
        "op": "contains",
        "window": {
          "from": {
            "chronology": "earth.unix.ms",
            "tick": "1767225600000"
          },
          "to": {
            "chronology": "earth.unix.ms",
            "tick": "1798761600000"
          },
          "calendar": "gregorian",
          "constraints": [
            {
              "field": "dayOfWeek",
              "in": [
                6,
                7
              ]
            }
          ]
        },
        "instant": {
          "chronology": "earth.unix.ms",
          "tick": "1789776000000"
        }
      },
      "expect": {
        "verdict": {
          "inside": true
        }
      }
