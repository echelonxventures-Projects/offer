            "tick": "1789813800000"
          },
          "temporal": {
            "chronology": "earth.unix.ms",
            "calendar": "gregorian",
            "zone": "UTC",
            "fields": {
              "year": 2026,
              "month": 9,
              "day": 19,
              "hour": 10,
              "minute": 30,
              "second": 0,
              "dayOfWeek": 6,
              "dayOfYear": 262,
              "quarter": 3
            }
          },
          "spatial": {
            "place": "earth.in.br.patna",
            "path": [
              "sol",
              "earth",
              "earth.in",
              "earth.in.br",
              "earth.in.br.patna"
            ],
            "jurisdiction": "IN-BR"
          },
          "economic": {
            "unit": "USD",
            "scale": 2
          },
