{
  "suite": "allocate",
  "level": "L2",
  "description": "Remainder-preserving division. Parts MUST sum exactly to the whole, and the remainder MUST go to the largest weight first, ties broken by index. This ordering is normative: it is what makes multi-party funding and attribution reconcilable.",
  "cases": [
    {
      "id": "0.01 three ways",
      "input": {
        "amount": {
          "unit": "USD",
          "minor": "1",
          "scale": 2
        },
        "weights": [
          "1",
          "1",
          "1"
        ]
      },
      "expect": {
        "parts": [
          {
            "unit": "USD",
            "minor": "1",
            "scale": 2
          },
          {
            "unit": "USD",
            "minor": "0",
            "scale": 2
          },
          {
            "unit": "USD",
            "minor": "0",
            "scale": 2
          }
        ],
        "sum": "1"
      }
    },
