      }
    },
    {
      "id": "all-short-circuits",
      "note": "the third child MUST NOT be evaluated",
      "input": {
        "rule": {
          "op": "all",
          "of": [
            {
              "op": "always"
            },
            {
              "op": "never"
            },
            {
              "op": "always"
            }
          ]
        }
      },
      "expect": {
        "satisfied": false,
        "trace": [
          {
            "op": "always",
            "result": true,
            "depth": 1
          },
          {
            "op": "never",
            "result": false,
            "depth": 1
          },
          {
            "op": "all",
            "result": false,
            "depth": 0
          }
        ]
      }
    },
