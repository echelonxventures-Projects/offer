                "unitPrice": {
                  "unit": "USD",
                  "minor": "3000",
                  "scale": 2
                },
                "categories": [
                  "grocery",
                  "beverage"
                ],
                "merchant": "m1"
              },
              {
                "id": "l2",
                "sku": "MUG-CERAMIC",
                "quantity": 1,
                "unitPrice": {
                  "unit": "USD",
                  "minor": "4000",
                  "scale": 2
                },
                "categories": [
                  "homeware"
                ],
