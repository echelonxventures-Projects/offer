              "a",
              "b"
            ]
          },
          "trace": []
        }
      },
      "expect": {}
    },
    {
      "id": "always",
      "input": {
        "rule": {
          "op": "always"
        }
      },
      "expect": {
        "satisfied": true,
        "trace": [
          {
            "op": "always",
            "result": true,
            "depth": 0
          }
        ]
      }
    },
