    {
      "id": "mars:conversion-and-fields",
      "note": "converting to a coarser tick floors; the loss is bounded by one target tick",
      "input": {
        "op": "convert",
        "from": {
          "chronology": "earth.unix.ms",
          "tick": "1789813800000"
        },
        "to": "mars.sol.msd"
      },
      "expect": {
        "instant": {
          "chronology": "mars.sol.msd",
          "tick": "54288479"
        },
        "fields": {
          "sol": 54288,
          "millisol": 479,
          "marsYear": 81,
          "solOfYear": 132
        }
