{
  "suite": "amount",
  "level": "L2",
  "description": "Exact integer money. Every rounding mode over positive and negative operands, percentages as exact rationals, and the refusals that keep units from mixing.",
  "cases": [
    {
      "id": "parse:12.34@2",
      "input": {
        "op": "fromDecimal",
        "unit": "X",
        "decimal": "12.34",
        "scale": 2
      },
      "expect": {
        "amount": {
          "unit": "X",
          "minor": "1234",
          "scale": 2
        },
        "toDecimal": "12.34"
      }
    },
    {
      "id": "parse:0.001@3",
      "input": {
        "op": "fromDecimal",
        "unit": "X",
        "decimal": "0.001",
        "scale": 3
      },
      "expect": {
        "amount": {
          "unit": "X",
          "minor": "1",
          "scale": 3
        },
        "toDecimal": "0.001"
      }
    },
    {
      "id": "parse:100@0",
